// # oocolor Root Subsystem Anchor
//
// Logline: Unified verification anchor certifying core math, terminal rendering, and IPC subsystems.
//
// Setup: Executes complete subsystem assertions across chromatic, rendering, and protocol domains.
//
// Beats:
//   1. Re-export and verify core chromatic math subsystem.
//   2. Re-export and verify terminal TrueColor rendering subsystem.
//   3. Re-export and verify JSON-RPC stdio IPC protocol subsystem.
//   4. Supply top-level verification suite predicate.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn verify_all_subsystems(fs: &FsReadCap) -> Bool {
    if !verify_core_subsystem() {
        return false;
    }

    if !verify_render_subsystem() {
        return false;
    }

    if !verify_ipc_subsystem(fs) {
        return false;
    }

    return true;
}
